CREATE TABLE `User` (
  `user_id` INT,
  `email` VARCHAR(255),
  `password` VARCHAR(255),
  `status` VARCHAR(20),
  `created_at` DATETIME,
  `username` VARCHAR(50),
  `avatar_url` VARCHAR(100),
  PRIMARY KEY (`user_id`),
  KEY `UNQ` (`email`)
);

CREATE TABLE `Labels` (
  `label_id` INT,
  `user_id` INT,
  `tag_name` VARCHAR(50),
  PRIMARY KEY (`label_id`),
  FOREIGN KEY (`user_id`)
      REFERENCES `User`(`user_id`)
);

CREATE TABLE `LabelApplied` (
  `contact_id` INT,
  `label_id` INT,
  FOREIGN KEY (`label_id`)
      REFERENCES `Labels`(`label_id`)
);

CREATE TABLE `ContactList` (
  `contact_id` INT,
  `owner_user_id` INT,
  `contact_user_id` INT,
  `added_at` DATETIME,
  PRIMARY KEY (`contact_id`),
  FOREIGN KEY (`contact_id`)
      REFERENCES `LabelApplied`(`contact_id`)
);

CREATE TABLE `Note` (
  `note_id` INT,
  `contact_id` INT,
  `content` TEXT,
  `created_at` DATETIME,
  `updated_at` DATETIME,
  PRIMARY KEY (`note_id`),
  FOREIGN KEY (`contact_id`)
      REFERENCES `ContactList`(`contact_id`)
);

CREATE TABLE `Page` (
  `page_id` INT,
  `user_id` INT,
  `title` VARCHAR(50),
  `config_json` TEXT,
  `page_url` VARCHAR(100),
  PRIMARY KEY (`page_id`),
  KEY `UNQ` (`page_url`)
);

CREATE TABLE `Component` (
  `component_id` INT,
  `page_id` INT,
  `type` VARCHAR(20),
  `data_json` TEXT,
  `display_order` INT,
  PRIMARY KEY (`component_id`),
  FOREIGN KEY (`page_id`)
      REFERENCES `Page`(`page_id`)
);

CREATE TABLE `Admin` (
  `admin_id` INT,
  `email` VARCHAR(255),
  `password` VARCHAR(255),
  `created_at` DATETIME,
  PRIMARY KEY (`admin_id`),
  KEY `UNQ` (`email`)
);

